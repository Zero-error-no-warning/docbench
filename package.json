{
  "name": "docbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:definition-editor": "vite --config vite.config.ts --open /definition-editor/index.html",
    "dev:render-designer": "vite --config vite.config.ts --open /render-designer/index.html",
    "dev:form-runtime": "vite --config vite.config.ts --open /form-runtime/index.html",
    "build": "tsc --noEmit && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "^8.2.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
